{
  "name": "yahor-portfolio",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:preview": "astro dev --host 127.0.0.1 --port 4321",
    "dev:lan": "ASTRO_DEV_HOST=true astro dev",
    "start": "astro dev",
    "build": "node ./scripts/write-site-verification.mjs && astro build",
    "preview": "astro preview",
    "preview:local": "bash ./scripts/preview-local.sh",
    "check": "astro sync && tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "a11y": "bash ./scripts/a11y-audit.sh",
    "generate:og": "node ./scripts/generate-og-image.mjs",
    "flights:enrich:fr24": "node scripts/enrich-flights-fr24.mjs",
    "resume:pdf": "bash ./scripts/generate-resume-pdf.sh",
    "resume:pdf:ats": "bash ./scripts/generate-resume-pdf-ats.sh",
    "smoke": "node ./scripts/smoke-test.mjs",
    "smoke:flights": "node ./scripts/smoke-flights-gate.mjs",
    "deploy:cf": "bash ./scripts/deploy-cloudflare.sh",
    "verify": "npm run check && npm run build && npm run smoke && npm run smoke:flights",
    "audit:deps": "npm audit --audit-level=high",
    "audit:prod": "bash ./scripts/audit-production.sh",
    "indexnow:notify": "bash ./scripts/notify-indexnow.sh",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^7.1.3",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/cli": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260714.1",
    "@types/node": "^20.0.0",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "axios": "^1.18.1",
    "js-yaml": "^4.3.0",
    "fast-uri": "^4.1.1",
    "svgo": "^4.0.2",
    "sharp": "^0.35.3"
  }
}
