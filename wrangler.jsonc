{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "darashkevich-com",
  "main": "workers/flights-gate.ts",
  "compatibility_date": "2026-07-21",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/flights", "/flights/*"]
  }
}
