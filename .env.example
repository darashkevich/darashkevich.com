# Map tiles for /flights route map (MapLibre GL)
# Get a free key at https://cloud.maptiler.com/ or https://client.stadiamaps.com/
PUBLIC_MAP_TILES_PROVIDER=maptiler
PUBLIC_MAP_TILES_KEY=

# MapTiler uses the minimal "backdrop-dark" style, recolored to match the site palette.
# Stadia uses "stamen_toner_background", also recolored in code.

# Optional build-time data enrichment for /flights.
# This is a server-side/manual script token, never a PUBLIC_ browser variable.
FR24_API_TOKEN=
