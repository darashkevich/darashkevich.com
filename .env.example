# Password for private /flights page (Netlify edge function only; not used in local dev).
# Set in Netlify → Site configuration → Environment variables.
# Browser basic-auth username can be anything; only the password is checked.
FLIGHTS_PAGE_PASSWORD=

# Map tiles for /flights route map (MapLibre GL)
# Get a free key at https://cloud.maptiler.com/ or https://client.stadiamaps.com/
# Production: set both vars in Netlify → Site configuration → Environment variables
# (domain-restrict to darashkevich.com). Without a key, builds use demotiles.maplibre.org.
PUBLIC_MAP_TILES_PROVIDER=maptiler
PUBLIC_MAP_TILES_KEY=

# MapTiler uses the minimal "backdrop-dark" style, recolored to match the site palette.
# Stadia uses "stamen_toner_background", also recolored in code.

# Optional build-time data enrichment for /flights.
# This is a server-side/manual script token, never a PUBLIC_ browser variable.
FR24_API_TOKEN=

# Optional Cloudflare Web Analytics (cookie-less JS beacon).
# Cloudflare Dashboard → Analytics & logs → Web Analytics → Add a site → copy token from the JS snippet.
# Production: set in Netlify → Site configuration → Environment variables, then redeploy.
# Leave empty to omit the beacon entirely.
PUBLIC_CF_WEB_ANALYTICS_TOKEN=
