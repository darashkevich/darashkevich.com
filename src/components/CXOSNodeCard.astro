---
export interface CXOSNode {
  title: string;
  description: string;
  icon: 'signals' | 'operations' | 'automation' | 'voc' | 'business';
}

interface Props {
  node: CXOSNode;
  step: number;
}

const { node, step } = Astro.props;
---

<div class="min-w-0 max-w-full w-full group/li" role="listitem" aria-posinset={step} aria-setsize={5}>
  <article
    class:list={[
      'cx-os-card rounded-[1.1rem] border backdrop-blur-xl px-4 py-4 sm:px-4 sm:py-4 w-full h-full transition-[transform,box-shadow,border-color] duration-300 ease-out motion-reduce:transition-none',
      'hover:-translate-y-0.5 motion-reduce:hover:translate-y-0'
    ]}
    style="background-color: rgba(24, 28, 36, 0.72); border-color: rgba(148, 163, 184, 0.16); box-shadow: 0 8px 24px rgba(2, 6, 12, 0.42);"
  >
    <div class="flex flex-col items-center text-center">
      <span class="text-[0.6rem] font-semibold uppercase tracking-[0.22em] text-[var(--color-text-soft)] tabular-nums mb-0.5">
        {String(step).padStart(2, '0')}
      </span>
      <h3 class="text-sm sm:text-base lg:text-[0.95rem] 2xl:text-[1.05rem] font-semibold tracking-tight text-[var(--color-text)] leading-snug mb-2 px-0.5">
        {node.title}
      </h3>
      <div
        class="icon-rail mb-2.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border transition-[border-color,box-shadow,color] duration-300 ease-out motion-reduce:transition-none group-hover/li:border-[rgba(125,211,252,0.24)] group-hover/li:shadow-[0_0_20px_rgba(96,165,250,0.09)]"
        style="border-color: rgba(148, 163, 184, 0.18); background: color-mix(in srgb, var(--color-surface-strong) 65%, transparent);"
        aria-hidden="true"
      >
        {node.icon === 'signals' && (
          <svg class="h-4 w-4 text-[var(--color-icon)] transition-colors duration-300 group-hover/li:text-[var(--color-primary)]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        )}
        {node.icon === 'operations' && (
          <svg class="h-4 w-4 text-[var(--color-icon)] transition-colors duration-300 group-hover/li:text-[var(--color-primary)]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 4h6a2 2 0 012 2v2a2 2 0 01-2 2h-6a2 2 0 01-2-2V6a2 2 0 012-2zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 14h6a2 2 0 012 2v2a2 2 0 01-2 2h-6a2 2 0 01-2-2v-2a2 2 0 012-2z" />
          </svg>
        )}
        {node.icon === 'automation' && (
          <svg class="h-4 w-4 text-[var(--color-icon)] transition-colors duration-300 group-hover/li:text-[var(--color-primary)]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        )}
        {node.icon === 'voc' && (
          <svg class="h-4 w-4 text-[var(--color-icon)] transition-colors duration-300 group-hover/li:text-[var(--color-primary)]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        )}
        {node.icon === 'business' && (
          <svg class="h-4 w-4 text-[var(--color-icon)] transition-colors duration-300 group-hover/li:text-[var(--color-primary)]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        )}
      </div>
      <p class="text-[0.8125rem] text-[var(--color-text-muted)] leading-snug 2xl:text-sm max-w-[30ch] mx-auto">
        {node.description}
      </p>
    </div>
  </article>
</div>
