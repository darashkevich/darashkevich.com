---
import {
  flightSegments,
  unresolvedFlights,
  type FlightSegment
} from '../../data/flights';
import {
  formatDisplayDate,
  routeLabel,
  sortedSegmentsNewestFirst
} from '../../lib/flight-stats';
import {
  enrichmentDetail,
  getFlightEnrichment
} from '../../lib/flight-enrichment';

const tableSegments = sortedSegmentsNewestFirst([...flightSegments, ...unresolvedFlights]);
const decades = [...new Set(tableSegments.map((s) => Math.floor(s.year / 10) * 10))].sort((a, b) => b - a);
const years = [...new Set(tableSegments.map((s) => s.year))].sort((a, b) => b - a);

function rowClasses(confidence: FlightSegment['confidence']): string {
  if (confidence === 'partial') return 'flight-row flight-row--partial';
  if (confidence === 'unresolved') return 'flight-row flight-row--unresolved';
  return 'flight-row flight-row--confirmed';
}
---

<section aria-labelledby="flight-table-title" class="pb-4">
  <div class="mb-6">
    <h2 id="flight-table-title" class="text-2xl md:text-3xl font-bold text-[var(--color-text)] tracking-tight">Flight log</h2>
    <p class="text-sm text-[var(--color-text-muted)] mt-1">Newest first. Filter by confidence or year.</p>
  </div>

  <div class="flex flex-wrap gap-2 mb-5" role="group" aria-label="Flight filters">
    <button type="button" class="flight-filter is-active" data-filter="all" aria-pressed="true">All</button>
    <button type="button" class="flight-filter" data-filter="confirmed" aria-pressed="false">Confirmed</button>
    <button type="button" class="flight-filter" data-filter="partial" aria-pressed="false">Partial</button>
    <button type="button" class="flight-filter" data-filter="unresolved" aria-pressed="false">Unresolved</button>
    {years.slice(0, 8).map((year) => (
      <button type="button" class="flight-filter" data-filter={`year:${year}`} aria-pressed="false">{year}</button>
    ))}
    {decades.map((decade) => (
      <button type="button" class="flight-filter" data-filter={`decade:${decade}`} aria-pressed="false">{decade}s</button>
    ))}
  </div>

  <div class="flight-log-wrap overflow-x-auto rounded-[1.15rem] border" style="border-color: var(--color-border);">
    <table class="flight-log w-full text-sm">
      <thead>
        <tr class="text-left text-xs uppercase tracking-[0.12em] text-[var(--color-text-soft)]" style="background: color-mix(in srgb, var(--color-surface-strong) 88%, transparent);">
          <th class="px-4 py-3 font-medium" scope="col">Date</th>
          <th class="px-4 py-3 font-medium" scope="col">Route</th>
          <th class="px-4 py-3 font-medium" scope="col">Airline</th>
          <th class="px-4 py-3 font-medium" scope="col">Flight</th>
          <th class="px-4 py-3 font-medium" scope="col">Aircraft / FR24</th>
        </tr>
      </thead>
      <tbody id="flight-table-body">
        {tableSegments.map((segment) => {
          const enrichment = getFlightEnrichment(segment);
          const aircraft = enrichment?.aircraftType ?? segment.aircraft;
          const registration = enrichment?.aircraftRegistration;
          const detail = enrichment ? enrichmentDetail(enrichment) : null;
          const aircraftText = aircraft
            ? `${aircraft}${registration ? ` · ${registration}` : ''}${detail ? ` · ${detail}` : ''}`
            : '—';

          return (
            <tr
              class={rowClasses(segment.confidence)}
              data-confidence={segment.confidence}
              data-year={segment.year}
              data-decade={Math.floor(segment.year / 10) * 10}
            >
              <td class="px-4 py-3 text-[var(--color-text-muted)] whitespace-nowrap" data-label="Date">{formatDisplayDate(segment.date)}</td>
              <td class="px-4 py-3 text-[var(--color-text)] font-medium" data-label="Route">
                {routeLabel(segment)}
                {segment.notes && (
                  <p class="text-xs text-[var(--color-text-soft)] mt-1 max-w-md leading-relaxed font-normal">{segment.notes}</p>
                )}
              </td>
              <td class="px-4 py-3 text-[var(--color-text-muted)]" data-label="Airline">{segment.airline}</td>
              <td class="px-4 py-3 text-[var(--color-text-muted)]" data-label="Flight">{segment.flightNumber ?? '—'}</td>
              <td class="px-4 py-3 text-[var(--color-text-muted)]" data-label="Aircraft / FR24">
                {aircraft ? (
                  <>
                    <span class="flight-aircraft-primary">{aircraft}{registration ? ` · ${registration}` : ''}</span>
                    {detail && <p class="text-xs text-[var(--color-text-soft)] mt-1 max-w-sm leading-relaxed flight-aircraft-detail">{detail}</p>}
                    <span class="sr-only md:hidden">{aircraftText}</span>
                  </>
                ) : '—'}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</section>

<style>
  .flight-filter {
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface-strong) 84%, transparent);
    color: var(--color-text-muted);
    border-radius: 9999px;
    padding: 0.45rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .flight-filter:hover,
  .flight-filter.is-active {
    color: var(--color-text);
    border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
  }

  .flight-row td {
    border-top: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    vertical-align: top;
  }

  .flight-row.is-hidden {
    display: none;
  }

  .flight-row--partial {
    background: color-mix(in srgb, #f59e0b 6%, transparent);
  }

  .flight-row--unresolved {
    background: color-mix(in srgb, #ef4444 6%, transparent);
  }

  @media (max-width: 767px) {
    .flight-log-wrap {
      border: none;
      overflow: visible;
    }

    .flight-log thead {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .flight-log,
    .flight-log tbody,
    .flight-log tr,
    .flight-log td {
      display: block;
      width: 100%;
    }

    .flight-log tr {
      margin-bottom: 0.75rem;
      border: 1px solid var(--color-border);
      border-radius: 1.15rem;
      padding: 1rem;
      background: color-mix(in srgb, var(--color-surface) 94%, transparent);
    }

    .flight-log td {
      border-top: none;
      padding: 0.2rem 0;
    }

    .flight-log td::before {
      content: attr(data-label);
      display: block;
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-soft);
      margin-bottom: 0.15rem;
    }

    .flight-log td:first-child {
      margin-bottom: 0.35rem;
    }

    .flight-aircraft-primary,
    .flight-aircraft-detail {
      display: none;
    }
  }
</style>

<script src="/js/flights-table.js" defer></script>
