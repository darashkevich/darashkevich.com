---
import {
  flightSegments,
  unresolvedFlights,
  type FlightSegment
} from '../../data/flights';
import {
  formatDisplayDate,
  routeLabel,
  sortedSegmentsNewestFirst
} from '../../lib/flight-stats';
import {
  enrichmentDetail,
  getFlightEnrichment
} from '../../lib/flight-enrichment';

const tableSegments = sortedSegmentsNewestFirst([...flightSegments, ...unresolvedFlights]);
const decades = [...new Set(tableSegments.map((s) => Math.floor(s.year / 10) * 10))].sort((a, b) => b - a);
const years = [...new Set(tableSegments.map((s) => s.year))].sort((a, b) => b - a);

function rowClasses(confidence: FlightSegment['confidence']): string {
  if (confidence === 'partial') return 'flight-row flight-row--partial';
  if (confidence === 'unresolved') return 'flight-row flight-row--unresolved';
  return 'flight-row flight-row--confirmed';
}
---

<section aria-labelledby="flight-table-title" class="pb-4">
  <div class="mb-6">
    <h2 id="flight-table-title" class="text-2xl md:text-3xl font-bold text-[var(--color-text)] tracking-tight">Flight log</h2>
    <p class="text-sm text-[var(--color-text-muted)] mt-1">Newest first. Filter by confidence or year.</p>
  </div>

  <div class="flex flex-wrap gap-2 mb-5" role="tablist" aria-label="Flight filters">
    <button type="button" class="flight-filter is-active" data-filter="all">All</button>
    <button type="button" class="flight-filter" data-filter="confirmed">Confirmed</button>
    <button type="button" class="flight-filter" data-filter="partial">Partial</button>
    <button type="button" class="flight-filter" data-filter="unresolved">Unresolved</button>
    {years.slice(0, 8).map((year) => (
      <button type="button" class="flight-filter" data-filter={`year:${year}`}>{year}</button>
    ))}
    {decades.map((decade) => (
      <button type="button" class="flight-filter" data-filter={`decade:${decade}`}>{decade}s</button>
    ))}
  </div>

  <div class="hidden md:block overflow-x-auto rounded-[1.15rem] border" style="border-color: var(--color-border);">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-xs uppercase tracking-[0.12em] text-[var(--color-text-soft)]" style="background: color-mix(in srgb, var(--color-surface-strong) 88%, transparent);">
          <th class="px-4 py-3 font-medium">Date</th>
          <th class="px-4 py-3 font-medium">Route</th>
          <th class="px-4 py-3 font-medium">Airline</th>
          <th class="px-4 py-3 font-medium">Flight</th>
          <th class="px-4 py-3 font-medium">Aircraft / FR24</th>
        </tr>
      </thead>
      <tbody id="flight-table-body">
        {tableSegments.map((segment) => {
          const enrichment = getFlightEnrichment(segment);
          const aircraft = enrichment?.aircraftType ?? segment.aircraft;
          const registration = enrichment?.aircraftRegistration;
          const detail = enrichment ? enrichmentDetail(enrichment) : null;

          return (
            <tr
              class={rowClasses(segment.confidence)}
              data-confidence={segment.confidence}
              data-year={segment.year}
              data-decade={Math.floor(segment.year / 10) * 10}
            >
              <td class="px-4 py-3 text-[var(--color-text-muted)] whitespace-nowrap">{formatDisplayDate(segment.date)}</td>
              <td class="px-4 py-3 text-[var(--color-text)] font-medium">
                {routeLabel(segment)}
                {segment.notes && (
                  <p class="text-xs text-[var(--color-text-soft)] mt-1 max-w-md leading-relaxed font-normal">{segment.notes}</p>
                )}
              </td>
              <td class="px-4 py-3 text-[var(--color-text-muted)]">{segment.airline}</td>
              <td class="px-4 py-3 text-[var(--color-text-muted)]">{segment.flightNumber ?? '—'}</td>
              <td class="px-4 py-3 text-[var(--color-text-muted)]">
                {aircraft ? (
                  <>
                    <span>{aircraft}{registration ? ` · ${registration}` : ''}</span>
                    {detail && <p class="text-xs text-[var(--color-text-soft)] mt-1 max-w-sm leading-relaxed">{detail}</p>}
                  </>
                ) : '—'}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <div id="flight-card-list" class="md:hidden space-y-3">
    {tableSegments.map((segment) => {
      const enrichment = getFlightEnrichment(segment);
      const aircraft = enrichment?.aircraftType ?? segment.aircraft;
      const registration = enrichment?.aircraftRegistration;
      const detail = enrichment ? enrichmentDetail(enrichment) : null;

      return (
        <article
          class={`rounded-[1.15rem] border p-4 ${rowClasses(segment.confidence)}`}
          style="border-color: var(--color-border); background: color-mix(in srgb, var(--color-surface) 94%, transparent);"
          data-confidence={segment.confidence}
          data-year={segment.year}
          data-decade={Math.floor(segment.year / 10) * 10}
        >
          <div class="mb-2">
            <p class="text-sm text-[var(--color-text-muted)]">{formatDisplayDate(segment.date)}</p>
          </div>
          <p class="text-base font-semibold text-[var(--color-text)]">{routeLabel(segment)}</p>
          <p class="text-sm text-[var(--color-text-muted)] mt-1">{segment.airline}{segment.flightNumber ? ` · ${segment.flightNumber}` : ''}</p>
          {aircraft && (
            <p class="text-xs text-[var(--color-text-soft)] mt-2">
              {aircraft}{registration ? ` · ${registration}` : ''}{detail ? ` · ${detail}` : ''}
            </p>
          )}
          {segment.notes && <p class="text-xs text-[var(--color-text-soft)] mt-2 leading-relaxed">{segment.notes}</p>}
        </article>
      );
    })}
  </div>
</section>

<style>
  .flight-filter {
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface-strong) 84%, transparent);
    color: var(--color-text-muted);
    border-radius: 9999px;
    padding: 0.45rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .flight-filter:hover,
  .flight-filter.is-active {
    color: var(--color-text);
    border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
  }

  .flight-row td {
    border-top: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    vertical-align: top;
  }

  .flight-row.is-hidden,
  #flight-card-list .is-hidden {
    display: none;
  }
</style>

<script src="/js/flights-table.js" defer></script>
