---
import { flightSegments } from '../../data/flights';
import { countryForAirportCode, formatDisplayDate } from '../../lib/flight-stats';

type CountryVisit = {
  country: string;
  cities: Set<string>;
  firstDate: string;
  lastDate: string;
  touches: number;
};

const confirmedSegments = flightSegments.filter((segment) => segment.confidence === 'confirmed');
const countryVisits = new Map<string, CountryVisit>();
const airports = new Set<string>();
const cities = new Set<string>();
const cityTouches = new Map<string, number>();

for (const segment of confirmedSegments) {
  for (const { code, city } of [
    { code: segment.originCode, city: segment.originCity },
    { code: segment.destinationCode, city: segment.destinationCity }
  ]) {
    if (!code) continue;
    airports.add(code);
    if (city) {
      cities.add(city);
      cityTouches.set(city, (cityTouches.get(city) ?? 0) + 1);
    }

    const country = countryForAirportCode(code);
    if (!country) continue;

    const previous = countryVisits.get(country);
    countryVisits.set(country, {
      country,
      cities: new Set([...(previous?.cities ?? []), ...(city ? [city] : [])]),
      firstDate: previous && previous.firstDate < segment.date ? previous.firstDate : segment.date,
      lastDate: previous && previous.lastDate > segment.date ? previous.lastDate : segment.date,
      touches: (previous?.touches ?? 0) + 1
    });
  }
}

const countries = [...countryVisits.values()].sort((a, b) => a.firstDate.localeCompare(b.firstDate));
const recentCountries = [...countryVisits.values()]
  .sort((a, b) => b.lastDate.localeCompare(a.lastDate) || a.country.localeCompare(b.country))
  .slice(0, 8);

const topCities = [...cityTouches.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

function cityList(visit: CountryVisit): string {
  return [...visit.cities].sort((a, b) => a.localeCompare(b)).slice(0, 3).join(', ');
}
---

<section aria-labelledby="flight-passport-title" class="pb-10">
  <div class="grid lg:grid-cols-[0.95fr_1.35fr] gap-5">
    <div
      class="rounded-[1.35rem] border p-6 overflow-hidden relative"
      style="background: radial-gradient(circle at top right, color-mix(in srgb, var(--color-primary) 18%, transparent), transparent 42%), color-mix(in srgb, var(--color-surface-strong) 92%, transparent); border-color: var(--color-border); box-shadow: 0 14px 30px var(--color-shadow);"
    >
      <p class="text-xs uppercase tracking-[0.18em] text-[var(--color-text-soft)] mb-3">Travel passport</p>
      <h2 id="flight-passport-title" class="text-2xl md:text-3xl font-bold text-[var(--color-text)] tracking-tight">
        Countries by flight trail
      </h2>
      <p class="text-sm text-[var(--color-text-muted)] mt-3 leading-relaxed">
        A Been-inspired summary derived from the flight archive itself: airport countries, first arrivals, and repeat touches.
      </p>

      <div class="grid grid-cols-3 gap-3 mt-6">
        <div class="passport-stat">
          <span>{countries.length}</span>
          <p>Countries</p>
        </div>
        <div class="passport-stat">
          <span>{cities.size}</span>
          <p>Cities</p>
        </div>
        <div class="passport-stat">
          <span>{airports.size}</span>
          <p>Airports</p>
        </div>
      </div>
    </div>

    <div
      class="rounded-[1.35rem] border p-5 md:p-6"
      style="background: color-mix(in srgb, var(--color-surface) 94%, transparent); border-color: var(--color-border);"
    >
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5">
        <div>
          <h3 class="text-lg font-semibold text-[var(--color-text)]">Recent stamps</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Latest countries touched by confirmed flight records.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          {topCities.slice(0, 3).map(([city, count]) => (
            <span class="passport-chip">{city} · {count}</span>
          ))}
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-3">
        {recentCountries.map((visit) => (
          <article class="passport-stamp">
            <div>
              <p class="text-sm font-semibold text-[var(--color-text)]">{visit.country}</p>
              <p class="text-xs text-[var(--color-text-soft)] mt-1">{cityList(visit) || 'Airport trail'}</p>
            </div>
            <div class="text-right">
              <p class="text-xs text-[var(--color-text-muted)]">{formatDisplayDate(visit.lastDate)}</p>
              <p class="text-xs text-[var(--color-text-soft)] mt-1">{visit.touches} touches</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .passport-stat {
    border: 1px solid color-mix(in srgb, var(--color-border) 78%, transparent);
    border-radius: 1rem;
    padding: 0.85rem;
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
  }

  .passport-stat span {
    display: block;
    color: var(--color-text);
    font-size: 1.55rem;
    line-height: 1;
    font-weight: 800;
  }

  .passport-stat p {
    margin-top: 0.35rem;
    color: var(--color-text-soft);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .passport-chip {
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-primary) 30%, var(--color-border));
    padding: 0.25rem 0.6rem;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }

  .passport-stamp {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 76%, transparent);
    border-radius: 1rem;
    padding: 0.9rem;
    background: color-mix(in srgb, var(--color-surface-strong) 70%, transparent);
  }
</style>
