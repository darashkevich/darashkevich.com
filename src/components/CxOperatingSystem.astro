---
type StageIcon = 'signals' | 'ops' | 'ai' | 'voc' | 'decisions';

type Stage = {
  id: StageIcon;
  title: string;
  blurb: string;
};

const stages: Stage[] = [
  {
    id: 'signals',
    title: 'Customer Signals',
    blurb: 'Tickets, chat, surveys, and frontline themes enter a shared intake.',
  },
  {
    id: 'ops',
    title: 'Support Operations',
    blurb: 'Routing, workforce, QA, and vendor coverage keep quality at volume.',
  },
  {
    id: 'ai',
    title: 'AI & Self-Service',
    blurb: 'Knowledge, AI agents, and deflection cut friction without losing escalation control.',
  },
  {
    id: 'voc',
    title: 'Voice of Customer',
    blurb: 'Sentiment and issue trends become structured insight for the business.',
  },
  {
    id: 'decisions',
    title: 'Business Decisions',
    blurb: 'Product, retention, and ops act on what customers are telling you.',
  },
];
---

<section id="cx-os" class="pb-16 relative scroll-mt-28" aria-labelledby="cx-os-heading">
  <div class="max-w-7xl mx-auto px-8 lg:px-12">
    <div class="backdrop-blur-xl rounded-[1.6rem] p-8 md:p-12 border" style="background: color-mix(in srgb, var(--color-surface) 92%, transparent); border-color: var(--color-border); box-shadow: 0 18px 48px var(--color-shadow);">
      <div class="text-center mb-10 max-w-3xl mx-auto">
        <h2 id="cx-os-heading" class="text-4xl lg:text-5xl xl:text-6xl font-bold text-[var(--color-text)] mb-6 tracking-tight">
          CX Operating System
        </h2>
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">
          One flow from signal to decision—how support becomes a strategic engine, not a cost center.
          <span class="cx-os__instruction cx-os__instruction--desktop">Hover or focus a stage to follow the path.</span>
          <span class="cx-os__instruction cx-os__instruction--mobile">Tap a stage to follow the path.</span>
        </p>
      </div>

      <figure class="cx-os mx-auto max-w-5xl" data-cx-os>
        <svg
          class="cx-os__svg w-full h-auto"
          viewBox="0 0 1000 260"
          role="group"
          aria-labelledby="cx-os-svg-title cx-os-svg-desc"
        >
          <title id="cx-os-svg-title">CX Operating System flow</title>
          <desc id="cx-os-svg-desc">
            Five connected stages: Customer Signals, Support Operations, AI and Self-Service, Voice of Customer, and Business Decisions.
          </desc>

          <defs>
            <linearGradient id="cx-os-pipe" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="var(--color-primary)" stop-opacity="0.35" />
              <stop offset="100%" stop-color="var(--color-primary-dark)" stop-opacity="0.55" />
            </linearGradient>
            <filter id="cx-os-glow" x="-20%" y="-40%" width="140%" height="180%">
              <feGaussianBlur stdDeviation="6" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>

          <path
            class="cx-os__pipe"
            d="M70 108 H930"
            fill="none"
            stroke="url(#cx-os-pipe)"
            stroke-width="3"
            stroke-linecap="round"
            opacity="0.85"
            pointer-events="none"
          />
          <path
            class="cx-os__pipe-dots"
            d="M70 108 H930"
            fill="none"
            stroke="var(--color-primary)"
            stroke-width="2"
            stroke-dasharray="4 14"
            stroke-linecap="round"
            opacity="0.45"
            pointer-events="none"
          >
            <animate
              class="cx-os__pipe-animate"
              attributeName="stroke-dashoffset"
              from="0"
              to="-36"
              dur="2.8s"
              repeatCount="indefinite"
            />
          </path>

          {stages.map((stage, index) => {
            const x = 70 + index * 215;
            const nodeId = `cx-node-${stage.id}`;
            const hitX = Math.max(8, x - 102);
            const hitW = Math.min(200, 992 - hitX);
            const iconX = x - 12;
            const iconY = 96;
            return (
              <g
                class="cx-os__stage"
                data-stage={stage.id}
                data-title={stage.title}
                data-blurb={stage.blurb}
                data-interactive-stage
                tabindex="0"
                role="button"
                aria-pressed="false"
                aria-label={`${stage.title}: ${stage.blurb}`}
              >
                <rect
                  class="cx-os__hit-area"
                  x={hitX}
                  y="58"
                  width={hitW}
                  height="140"
                  fill="transparent"
                />
                <circle
                  class="cx-os__halo"
                  cx={x}
                  cy="108"
                  r="42"
                  fill="color-mix(in srgb, var(--color-primary) 12%, transparent)"
                  opacity="0"
                  pointer-events="none"
                />
                <circle
                  class="cx-os__node"
                  cx={x}
                  cy="108"
                  r="28"
                  fill="var(--color-surface-strong)"
                  stroke="var(--color-border)"
                  stroke-width="2"
                  pointer-events="none"
                />
                <use
                  class="cx-os__glyph"
                  href={`#cx-icon-${stage.id}`}
                  x={iconX}
                  y={iconY}
                  width="24"
                  height="24"
                  pointer-events="none"
                />
                <text
                  id={`${nodeId}-title`}
                  x={x}
                  y="178"
                  text-anchor="middle"
                  fill="var(--color-text)"
                  font-size="15"
                  font-weight="600"
                  font-family="ui-sans-serif, system-ui, sans-serif"
                  pointer-events="none"
                >
                  {stage.title}
                </text>
                {index < stages.length - 1 && (
                  <path
                    d={`M${x + 36} 108 L${x + 179} 108`}
                    fill="none"
                    stroke="var(--color-border)"
                    stroke-width="1.5"
                    class="cx-os__connector"
                    pointer-events="none"
                  />
                )}
              </g>
            );
          })}
        </svg>

        <ol class="cx-os__mobile-flow" aria-label="CX Operating System stages">
          {stages.map((stage) => (
            <li>
              <button
                type="button"
                class="cx-os__mobile-stage"
                data-stage={stage.id}
                data-title={stage.title}
                data-blurb={stage.blurb}
                data-interactive-stage
                aria-pressed="false"
              >
                <span class="cx-os__mobile-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <use href={`#cx-icon-${stage.id}`} width="24" height="24" />
                  </svg>
                </span>
                <span>{stage.title}</span>
              </button>
            </li>
          ))}
        </ol>

        <p
          class="cx-os__live mt-5 text-center text-base text-[var(--color-text-muted)] leading-relaxed min-h-[3rem] max-w-2xl mx-auto transition-opacity duration-300"
          data-cx-os-live
          aria-live="polite"
        ></p>
      </figure>
    </div>
  </div>
</section>

{/* Shared glyphs for desktop chart + mobile list (must stay in DOM when chart is hidden) */}
<svg class="cx-os__symbol-store" aria-hidden="true" focusable="false">
  <symbol id="cx-icon-signals" viewBox="0 0 24 24">
    <path d="M2 12h2" />
    <path d="M20 12h2" />
    <path d="M6.3 6.3 7.7 7.7" />
    <path d="m16.3 16.3 1.4 1.4" />
    <path d="M12 2v2" />
    <path d="M12 20v2" />
    <path d="m16.3 7.7 1.4-1.4" />
    <path d="m6.3 17.7 1.4-1.4" />
    <circle cx="12" cy="12" r="3.25" />
  </symbol>
  <symbol id="cx-icon-ops" viewBox="0 0 24 24">
    <path d="M4 13a8 8 0 0 1 16 0" />
    <path d="M4 13v3a2 2 0 0 0 2 2h1v-5H6a2 2 0 0 0-2 2Z" />
    <path d="M20 13v3a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 2Z" />
    <path d="M9 19h6" />
    <path d="M12 19v2" />
  </symbol>
  <symbol id="cx-icon-ai" viewBox="0 0 24 24">
    <path d="M12 2v4" />
    <rect x="4" y="6" width="16" height="12" rx="3" />
    <path d="M2 12h2M20 12h2" />
    <circle cx="9" cy="12" r="1.15" fill="currentColor" stroke="none" />
    <circle cx="15" cy="12" r="1.15" fill="currentColor" stroke="none" />
    <path d="M9 16h6" />
  </symbol>
  <symbol id="cx-icon-voc" viewBox="0 0 24 24">
    <path d="M4 19V9" />
    <path d="M10 19V5" />
    <path d="M16 19v-7" />
    <path d="M22 19H2" />
  </symbol>
  <symbol id="cx-icon-decisions" viewBox="0 0 24 24">
    <path d="M22 7 13.5 15.5 8.5 10.5 2 17" />
    <path d="M16 7h6v6" />
  </symbol>
</svg>

<style>
  .cx-os__instruction--mobile,
  .cx-os__mobile-flow {
    display: none;
  }

  .cx-os__symbol-store {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* Let stage groups receive hits; decorative SVG chrome stays inert */
  .cx-os__svg {
    pointer-events: none;
  }

  .cx-os__stage {
    cursor: pointer;
    outline: none;
    pointer-events: auto;
  }

  .cx-os__hit-area {
    pointer-events: auto;
  }

  .cx-os__glyph {
    color: color-mix(in srgb, var(--color-primary) 72%, var(--color-text-soft));
    stroke: currentColor;
    fill: none;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: color 180ms ease;
  }

  .cx-os__stage:focus-visible .cx-os__node,
  .cx-os__stage:hover .cx-os__node,
  .cx-os__stage.is-lit .cx-os__node {
    stroke: var(--color-primary);
    filter: url(#cx-os-glow);
  }

  .cx-os__stage:focus-visible .cx-os__halo,
  .cx-os__stage:hover .cx-os__halo,
  .cx-os__stage.is-lit .cx-os__halo {
    opacity: 1;
  }

  .cx-os__stage:focus-visible .cx-os__glyph,
  .cx-os__stage:hover .cx-os__glyph,
  .cx-os__stage.is-lit .cx-os__glyph {
    color: var(--color-primary);
  }

  @media (max-width: 639px) {
    .cx-os__instruction--desktop,
    .cx-os__svg {
      display: none;
    }

    .cx-os__instruction--mobile {
      display: inline;
    }

    .cx-os__mobile-flow {
      display: grid;
      gap: 0.55rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .cx-os__mobile-stage {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      width: 100%;
      min-height: 3rem;
      padding: 0.65rem 0.8rem;
      border: 1px solid var(--color-border);
      border-radius: 0.85rem;
      background: color-mix(in srgb, var(--color-surface-strong) 88%, transparent);
      color: var(--color-text);
      font-size: 0.95rem;
      font-weight: 600;
      text-align: left;
    }

    .cx-os__mobile-stage:focus-visible,
    .cx-os__mobile-stage.is-lit {
      border-color: var(--color-primary);
      background: color-mix(in srgb, var(--color-primary) 12%, var(--color-surface-strong));
      outline: 2px solid color-mix(in srgb, var(--color-primary) 55%, transparent);
      outline-offset: 2px;
    }

    .cx-os__mobile-icon {
      display: inline-grid;
      place-items: center;
      flex: 0 0 1.85rem;
      width: 1.85rem;
      height: 1.85rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--color-primary) 16%, transparent);
      color: var(--color-primary);
    }

    .cx-os__mobile-icon svg {
      width: 1rem;
      height: 1rem;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .cx-os__mobile-stage.is-lit .cx-os__mobile-icon,
    .cx-os__mobile-stage:focus-visible .cx-os__mobile-icon {
      background: color-mix(in srgb, var(--color-primary) 28%, transparent);
    }

    .cx-os__live {
      min-height: 5rem;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cx-os__glyph {
      transition: none;
    }
  }
</style>

<script>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.cx-os__pipe-animate').forEach((el) => el.remove());
  }

  const root = document.querySelector('[data-cx-os]');
  if (root) {
    const stages = root.querySelectorAll('[data-interactive-stage]');
    const live = root.querySelector('[data-cx-os-live]');

    function clearLit() {
      stages.forEach((s) => {
        s.classList.remove('is-lit');
        s.setAttribute('aria-pressed', 'false');
      });
      if (live) live.textContent = '';
    }

    function light(stage) {
      stages.forEach((s) => {
        const active = s === stage;
        s.classList.toggle('is-lit', active);
        s.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      if (live && stage) {
        const title = stage.dataset.title ?? '';
        const blurb = stage.dataset.blurb ?? '';
        live.textContent = title && blurb ? `${title} — ${blurb}` : '';
      }
    }

    stages.forEach((stage) => {
      stage.addEventListener('mouseenter', () => light(stage));
      stage.addEventListener('mouseleave', () => {
        if (!stage.matches(':focus')) clearLit();
      });
      stage.addEventListener('focus', () => light(stage));
      stage.addEventListener('blur', clearLit);
      stage.addEventListener('click', () => light(stage));
      stage.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          light(stage);
        }
      });
    });
  }
</script>
