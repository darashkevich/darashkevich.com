---
const proof = [
  { value: '95+', label: 'Agents at peak' },
  { value: '1.5M+', label: 'Tickets resolved' },
  { value: '45%', label: 'Chats resolved by AI' },
];
---

<section class="relative flex items-center overflow-hidden pt-24 pb-12 sm:pt-28 sm:pb-16 lg:min-h-[78vh] lg:pb-20" aria-labelledby="hero-name">
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <div class="absolute -top-16 left-[8%] w-[34rem] h-[34rem] rounded-full blur-3xl animate-float" style="background: radial-gradient(circle at center, color-mix(in srgb, var(--color-primary) 18%, transparent), transparent 68%);"></div>
    <div class="absolute bottom-[-9rem] right-[4%] w-[30rem] h-[30rem] rounded-full blur-3xl animate-float" style="background: radial-gradient(circle at center, color-mix(in srgb, var(--color-primary-dark) 16%, transparent), transparent 70%); animation-delay: 3s;"></div>
  </div>

  <div class="relative z-10 w-full max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow mb-4">Open to VP and Head of Customer Experience roles</p>
        <h1 id="hero-name" class="hero-name text-[var(--color-text)]">Yahor Darashkevich</h1>
        <p class="hero-lede">
          Customer Experience and Support Operations executive for high-growth SaaS, eCommerce, and subscription companies.
        </p>
        <dl class="hero-stats">
          {proof.map((item) => (
            <div>
              <dt>{item.value}</dt>
              <dd>{item.label}</dd>
            </div>
          ))}
        </dl>
        <div class="hero-actions">
          <a href="#contact" class="btn-primary inline-flex items-center justify-center rounded-[1.15rem] px-7 py-3.5 text-base font-semibold transition-all duration-300 hover:-translate-y-0.5">
            Discuss Opportunities
          </a>
          <a href="/YD_resume.pdf" download="YD_resume.pdf" class="hero-resume">
            Download resume
          </a>
        </div>
      </div>
      <img
        class="hero-portrait"
        src="/images/avatar.webp"
        alt=""
        width="640"
        height="640"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    justify-items: center;
    gap: 1.75rem;
    text-align: center;
  }

  .hero-name {
    max-width: 12ch;
    margin-inline: auto;
    font-size: clamp(2.65rem, 6vw, 4.6rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.035em;
  }

  .hero-lede {
    max-width: 38rem;
    margin: 1rem auto 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem 1rem;
    width: min(100%, 34rem);
    margin: 1.75rem auto 0;
  }

  .hero-stats dt {
    color: var(--color-primary);
    font-size: clamp(1.45rem, 2.4vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .hero-stats dd {
    margin: 0.4rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }

  .hero-actions .btn-primary {
    width: 100%;
  }

  .hero-resume {
    color: var(--color-text-muted);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero-resume:hover {
    color: var(--color-primary);
  }

  .hero-portrait {
    width: 7.75rem;
    height: 7.75rem;
    order: -1;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
    box-shadow: 0 18px 40px rgba(2, 6, 12, 0.45);
  }

  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      justify-content: center;
    }

    .hero-actions .btn-primary {
      width: auto;
    }
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 16.5rem;
      align-items: center;
      justify-items: start;
      gap: 4rem;
      text-align: left;
    }

    .hero-name,
    .hero-lede,
    .hero-stats {
      margin-left: 0;
      margin-right: 0;
    }

    .hero-actions {
      justify-content: flex-start;
    }

    .hero-portrait {
      width: 16.5rem;
      height: 16.5rem;
      order: 0;
      justify-self: end;
    }
  }
</style>
