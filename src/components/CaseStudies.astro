---
const caseStudies = [
  {
    id: 'case-kachava',
    company: "Ka'Chava",
    title: 'Scaled Support Infrastructure During Hypergrowth',
    summary:
      'Built a multi-channel support operating model that carried the company from early-stage support into enterprise-level volume while preserving quality.',
    outcomes: [
      'Scaled from 1 to 95+ agents at peak growth',
      '1.5M+ resolved tickets',
      '35K tickets per month at peak volume',
      '89%+ CSAT maintained under sustained volume',
      'Under 4 hours first reply time',
      '45% of chats fully resolved by AI, and growing',
      '2 BPOs Managed',
    ]
  },
  {
    id: 'case-teachpoint',
    company: 'TeachPoint',
    title: 'Reduced Ticket Volume Through Workflow Redesign',
    summary:
      'Re-architected Zendesk workflows, self-service content, and agent operating practices to reduce support friction and improve resolution consistency.',
    outcomes: ['Helped reduce avoidable ticket volume through workflow and self-service improvements.', 'Faster first-response performance', 'Improved quality and consistency of resolutions']
  },
  {
    id: 'case-advisory',
    company: 'Multi-Brand Advisory',
    title: 'Established Executive CX Operating Systems',
    summary:
      'Partnered with leadership teams to define governance, KPI ownership, vendor accountability, and AI-assisted support strategy across multiple brands.',
    outcomes: ['Clearer CX ownership at leadership level', 'Improved executive reporting cadence', 'Stronger retention and VoC signal visibility']
  }
];
---

<section id="case-studies" class="pb-20 md:pb-24 relative">
  <div class="max-w-7xl mx-auto px-8 lg:px-12">
    <div class="text-center mb-16">
      <h2 class="text-4xl lg:text-5xl xl:text-6xl font-bold text-[var(--color-text)] mb-6 tracking-tight">Selected Case Studies</h2>
      <p class="text-lg text-[var(--color-text-muted)] max-w-3xl mx-auto leading-relaxed">
        Transformation stories that connect operational change to measurable customer and business impact.
      </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-6 md:gap-7">
      {caseStudies.map((item) => (
        <article id={item.id} class="h-full rounded-[1.35rem] border p-7 md:p-8 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1.5 hover:border-[color:var(--color-primary-dark)] hover:shadow-[0_22px_44px_rgba(2,6,12,0.58)] scroll-mt-28" style="background: color-mix(in srgb, var(--color-surface) 94%, transparent); border-color: var(--color-border); box-shadow: 0 16px 34px var(--color-shadow);">
          <p class="text-xs uppercase tracking-[0.18em] text-[var(--color-text-soft)] mb-3">{item.company}</p>
          <h3 class="text-[1.6rem] font-semibold text-[var(--color-text)] tracking-[-0.01em] leading-tight mb-4">{item.title}</h3>
          <p class="text-base text-[var(--color-text-muted)] leading-7 mb-6 max-w-[34ch]">{item.summary}</p>
          <ul class="space-y-2">
            {item.outcomes.map((outcome) => (
              <li class="text-sm text-[var(--color-text-muted)] flex items-start gap-2.5">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-[var(--color-icon)]"></span>
                <span class="leading-6">{outcome}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
