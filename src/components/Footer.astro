---
const currentYear = new Date().getFullYear();
---

<footer class="relative pb-20">
  <div class="max-w-7xl mx-auto px-8 lg:px-12">
    <div class="backdrop-blur-xl rounded-3xl p-8 border" style="background-color: var(--color-surface); border-color: var(--color-border); box-shadow: 0 12px 30px var(--color-shadow);">
      <div class="flex flex-col md:flex-row justify-between items-center">
        <div class="text-[var(--color-text-muted)] text-lg mb-6 md:mb-0">
          &copy; {currentYear} Yahor Darashkevich. All rights reserved.
        </div>
        <div class="flex space-x-8 text-lg text-[var(--color-text-muted)]">
          <a href="/privacy-policy" class="hover:text-[var(--color-primary)] underline underline-offset-2 transition-colors duration-300">Privacy Policy</a>
          <a href="/terms-of-service" class="hover:text-[var(--color-primary)] underline underline-offset-2 transition-colors duration-300">Terms of Service</a>
          <a href="/accessibility" class="hover:text-[var(--color-primary)] underline underline-offset-2 transition-colors duration-300">Accessibility</a>
        </div>
      </div>
    </div>
  </div>
</footer>
