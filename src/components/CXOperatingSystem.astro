---
import CXOSNodeCard from './CXOSNodeCard.astro';
import type { CXOSNode } from './CXOSNodeCard.astro';

const nodes: readonly CXOSNode[] = [
  {
    title: 'Customer Signals',
    description:
      'Tickets, CSAT, sentiment, product feedback, refund reasons, subscription friction',
    icon: 'signals'
  },
  {
    title: 'Support Operations',
    description:
      'Workflows, QA standards, escalation paths, staffing models, vendor performance',
    icon: 'operations'
  },
  {
    title: 'Automation & Self-Service',
    description:
      'Help centers, macros, AI agents, knowledge systems, deflection strategy',
    icon: 'automation'
  },
  {
    title: 'Voice of Customer',
    description:
      'Issue trends, customer pain points, retention risks, operational bottlenecks',
    icon: 'voc'
  },
  {
    title: 'Business Decisions',
    description:
      'Product fixes, fulfillment improvements, lifecycle changes, executive reporting',
    icon: 'business'
  }
];

const row1 = nodes.slice(0, 3);
const row2 = nodes.slice(3, 5);
---

<section
  id="cx-operating-system"
  class="relative py-14 md:py-16 overflow-x-hidden"
  aria-labelledby="cx-os-heading"
>
  <div class="max-w-7xl mx-auto px-8 lg:px-12">
    <div class="text-center max-w-4xl mx-auto mb-8 md:mb-10">
      <h2 id="cx-os-heading" class="text-4xl lg:text-5xl xl:text-6xl font-bold text-[var(--color-text)] mb-4 tracking-tight">
        CX Operating System
      </h2>
      <p id="cx-os-intro" class="text-base md:text-lg text-[var(--color-text-muted)] leading-relaxed">
        High-performing support teams do more than resolve tickets. They turn customer signals into operational clarity, better self-service, and smarter business decisions.
      </p>
      <p class="sr-only">
        Five-stage flow, in order: Customer Signals, then Support Operations, then Automation and Self-Service, then Voice of Customer, ending with Business Decisions. Each stage builds on the previous one.
      </p>
    </div>

    <div class="relative rounded-[1.35rem] border px-3 py-6 sm:px-5 md:px-8 md:py-8 overflow-hidden" style="border-color: rgba(148, 163, 184, 0.12); background: color-mix(in srgb, var(--color-bg-soft) 55%, transparent);">
      <div class="pointer-events-none absolute inset-0 -z-0" aria-hidden="true">
        <div
          class="absolute left-1/2 top-1/2 w-[min(110%,48rem)] h-[min(75%,28rem)] -translate-x-1/2 -translate-y-1/2 rounded-[50%] motion-reduce:opacity-100"
          style="background: radial-gradient(ellipse 55% 45% at 50% 45%, rgba(96, 165, 250, 0.11) 0%, rgba(125, 211, 252, 0.04) 38%, transparent 68%);"
        />
      </div>
      <div
        class="pointer-events-none absolute inset-1.5 rounded-[1.2rem] opacity-[0.12] motion-reduce:opacity-[0.12]"
        style="background-image: linear-gradient(to right, rgba(148, 163, 184, 0.14) 1px, transparent 1px), linear-gradient(to bottom, rgba(148, 163, 184, 0.14) 1px, transparent 1px); background-size: 32px 32px; mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, black 18%, transparent 75%);"
        aria-hidden="true"
      />
      <div
        class="pointer-events-none absolute inset-0 rounded-[1.35rem] opacity-[0.05] motion-reduce:opacity-[0.05]"
        style="background-image: radial-gradient(rgba(255, 255, 255, 0.05) 0.5px, transparent 0.5px); background-size: 3px 3px;"
        aria-hidden="true"
      />

      <!-- Mobile: single column -->
      <div class="lg:hidden relative z-10 flex flex-col items-center" role="list" aria-label="CX Operating System stages">
        {nodes.map((node, i) => (
          <>
            <CXOSNodeCard node={node} step={i + 1} />
            {i < nodes.length - 1 && (
              <div class="flex flex-col items-center py-2 w-full max-w-lg mx-auto" role="presentation" aria-hidden="true">
                <div class="w-px h-5 sm:h-6 bg-gradient-to-b from-transparent via-[rgba(148,163,184,0.35)] to-transparent shrink-0" />
                <svg class="w-3.5 h-3.5 -mt-0.5 text-[rgba(125,211,252,0.5)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            )}
          </>
        ))}
      </div>

      <!-- Desktop: 3 + 2 centered rows -->
      <div class="hidden lg:flex relative z-10 w-full flex-col items-center gap-6 xl:gap-7" role="list" aria-label="CX Operating System stages">
        <div class="flex w-full max-w-6xl flex-row flex-nowrap items-stretch justify-center gap-x-0 min-w-0">
          {row1.map((node, j) => (
            <>
              <div class:list={['min-w-0 w-[min(100%,17.5rem)] 2xl:w-[min(100%,18.75rem)] shrink-0', j === 1 && 'lg:mt-4 xl:mt-5']}>
                <CXOSNodeCard node={node} step={j + 1} />
              </div>
              {j < row1.length - 1 && (
                <div class="hidden lg:flex items-center justify-center self-center px-0.5 w-7 2xl:w-8 shrink-0" role="presentation" aria-hidden="true">
                  <div class="flex items-center justify-center">
                    <div class="h-px w-1.5 2xl:w-2 shrink-0 rounded-full bg-gradient-to-r from-transparent to-[rgba(125,211,252,0.22)]" />
                    <svg class="w-3 h-3 shrink-0 text-[rgba(125,211,252,0.45)] mx-px" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                    <div class="h-px w-1.5 2xl:w-2 shrink-0 rounded-full bg-gradient-to-l from-transparent to-[rgba(125,211,252,0.18)]" />
                  </div>
                </div>
              )}
            </>
          ))}
        </div>

        <div class="flex flex-col items-center gap-1" role="presentation" aria-hidden="true">
          <div class="h-5 w-px bg-gradient-to-b from-[rgba(125,211,252,0.2)] via-[rgba(148,163,184,0.35)] to-[rgba(125,211,252,0.15)] rounded-full" />
          <svg class="w-3.5 h-3.5 text-[rgba(125,211,252,0.45)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </div>

        <div class="flex w-full max-w-3xl flex-row flex-nowrap items-stretch justify-center gap-x-0 min-w-0">
          {row2.map((node, j) => (
            <>
              <div class="min-w-0 w-[min(100%,17.5rem)] 2xl:w-[min(100%,18.75rem)] shrink-0">
                <CXOSNodeCard node={node} step={j + 4} />
              </div>
              {j < row2.length - 1 && (
                <div class="hidden lg:flex items-center justify-center self-center px-0.5 w-7 2xl:w-8 shrink-0" role="presentation" aria-hidden="true">
                  <div class="flex items-center justify-center">
                    <div class="h-px w-1.5 2xl:w-2 shrink-0 rounded-full bg-gradient-to-r from-transparent to-[rgba(125,211,252,0.22)]" />
                    <svg class="w-3 h-3 shrink-0 text-[rgba(125,211,252,0.45)] mx-px" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                    <div class="h-px w-1.5 2xl:w-2 shrink-0 rounded-full bg-gradient-to-l from-transparent to-[rgba(125,211,252,0.18)]" />
                  </div>
                </div>
              )}
            </>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (hover: hover) and (pointer: fine) {
    .cx-os-card:hover {
      border-color: rgba(125, 211, 252, 0.28) !important;
      box-shadow:
        0 0 0 1px rgba(96, 165, 250, 0.12),
        0 14px 36px rgba(2, 6, 12, 0.52),
        0 0 48px -14px rgba(96, 165, 250, 0.07) !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cx-os-card,
    .icon-rail {
      transition: none !important;
    }
    .cx-os-card:hover {
      transform: none !important;
    }
  }
</style>
