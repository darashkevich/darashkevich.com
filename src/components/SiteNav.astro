---
const links = [
  { href: '#impact', label: 'Impact' },
  { href: '#case-studies', label: 'Case Studies' },
  { href: '#cx-os', label: 'Operating System' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
  <nav class="site-header__bar" aria-label="Primary">
    <a href="/" class="site-header__brand" aria-label="Yahor Darashkevich, home">
      <img
        src="/images/avatar.webp"
        alt=""
        width="96"
        height="96"
        loading="eager"
        decoding="async"
      />
    </a>

    <div class="site-header__links">
      {links.map((link) => (
        <a href={link.href} class="site-header__link">{link.label}</a>
      ))}
    </div>

    <button
      id="mobile-menu-button"
      class="site-header__menu"
      aria-label="Toggle mobile menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="menu-icon" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="lg:hidden fixed inset-0 bg-black/75 z-[120] transform translate-x-full transition-all duration-400 ease-out pointer-events-none" role="dialog" aria-modal="true" aria-hidden="true" inert aria-labelledby="mobile-menu-title">
    <div class="mobile-menu-panel absolute top-0 right-0 h-full w-[min(86vw,21.5rem)] backdrop-blur-xl shadow-2xl transform translate-x-full transition-all duration-400 ease-out border-l z-[91]" style="background: linear-gradient(180deg, rgba(18, 25, 36, 0.98), rgba(12, 17, 26, 0.98)); border-color: rgba(125, 146, 181, 0.30);" tabindex="-1">
      <div class="p-8">
        <h2 id="mobile-menu-title" class="sr-only">Mobile navigation</h2>
        <div class="flex justify-between items-center mb-12">
          <a href="/" class="w-12 h-12 rounded-full overflow-hidden border shadow-lg" style="border-color: var(--color-border);" aria-label="Yahor Darashkevich, home">
            <img
              src="/images/avatar.webp"
              alt=""
              class="w-full h-full object-cover"
              width="96"
              height="96"
              decoding="async"
            />
          </a>
          <button
            id="mobile-menu-close"
            class="text-[var(--color-text-muted)] hover:text-[var(--color-primary)] transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] rounded-2xl p-3 hover:bg-white/10 border border-white/10"
            aria-label="Close mobile menu"
          >
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <div class="space-y-3">
          {links.map((link) => (
            <a
              href={link.href}
              class="mobile-nav-link block rounded-2xl text-xl font-semibold tracking-tight text-[var(--color-text)] hover:text-[var(--color-primary)] transition-all duration-300 px-4 py-4 border border-white/10 hover:border-[color:var(--color-border)] hover:bg-white/5"
            >
              {link.label}
            </a>
          ))}
        </div>

        <div class="mt-8 flex items-center gap-3 pt-5 border-t border-white/10">
          <a href="https://www.linkedin.com/in/darashkevich" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="site-header__icon">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.047-1.852-3.047-1.853 0-2.136 1.445-2.136 2.939v5.677H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
            </svg>
          </a>
          <a href="mailto:yahor@darashkevich.com" aria-label="Email Yahor" class="site-header__icon">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </a>
          <a href="tel:+1-617-528-9656" aria-label="Call Yahor" class="site-header__icon">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script src="/js/mobile-menu.js" defer></script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(16px);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0.75rem 1rem;
  }

  .site-header__brand {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    overflow: hidden;
    border-radius: 999px;
    border: 1px solid var(--color-border);
  }

  .site-header__brand img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .site-header__links {
    display: none;
    align-items: center;
    gap: 0.15rem;
  }

  .site-header__link {
    padding: 0.45rem 0.7rem;
    border-radius: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .site-header__link:hover {
    color: var(--color-primary);
    background: rgba(255, 255, 255, 0.06);
  }

  .site-header__menu {
    display: inline-flex;
    padding: 0.4rem;
    border-radius: 0.75rem;
    color: var(--color-text-muted);
  }

  .site-header__menu:hover {
    color: var(--color-primary);
  }

  .site-header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.85rem;
    border: 1px solid var(--color-border);
    color: var(--color-icon);
    background: rgba(24, 33, 49, 0.74);
  }

  .site-header__icon:hover {
    color: var(--color-primary);
  }

  @media (min-width: 1024px) {
    .site-header__links {
      display: flex;
    }

    .site-header__menu {
      display: none;
    }

    .site-header__brand {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>
