---
const services = [
  {
    title: 'Customer Operations Strategy',
    description: 'Design scalable support operating models that align people, process, systems, KPIs, and customer experience around business growth.',
  },
  {
    title: 'AI, Self-Service & Support Automation',
    description: 'Design and optimize AI-powered support experiences that reduce contact volume, improve resolution speed, and help customers get accurate answers faster.',
  },
  {
    title: 'Support Team Scaling & Workforce Design',
    description: 'Build and scale support teams that can handle growth without sacrificing quality, consistency, or customer trust.',
  },
  {
    title: 'Zendesk & CX Systems Optimization',
    description: 'Optimize Zendesk and connected support tools to improve speed, consistency, reporting, and customer visibility.',
  },
  {
    title: 'Voice of Customer & Customer Insight',
    description: 'Turn support data into actionable customer intelligence for product, retention, marketing, operations, and leadership teams.',
  },
  {
    title: 'Vendor / BPO Performance Management',
    description: 'Create accountable outsourced support partnerships that scale efficiently while protecting customer experience quality.',
  },
];
---

<section id="services" class="pb-8 pt-4 relative scroll-mt-28">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="max-w-2xl mb-8">
      <p class="eyebrow mb-3">Selective consulting</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--color-text)]">
        How I Can Help
      </h2>
      <p class="mt-3 text-base text-[var(--color-text-muted)] leading-relaxed">
        Executive-level customer operations support across strategy, systems, AI-enabled support, team scaling, and performance management.
      </p>
    </div>

    <ul class="grid md:grid-cols-2 gap-x-12 gap-y-6">
      {services.map((service) => (
        <li class="border-t border-[color:var(--color-border)] pt-4">
          <h3 class="text-lg font-semibold text-[var(--color-text)] tracking-tight">{service.title}</h3>
          <p class="mt-1.5 text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">{service.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
