---
const services = [
  {
    title: 'Customer Operations Strategy',
    description: 'Design scalable support operating models that align people, process, systems, KPIs, and customer experience around business growth.',
    bullets: [
      'Support org design and operating models',
      'KPI frameworks and executive reporting',
      'Process improvement and escalation strategy',
      'Cross-functional CX alignment'
    ],
    icon: 'briefcase'
  },
  {
    title: 'AI, Self-Service & Support Automation',
    description: 'Design and optimize AI-powered support experiences that reduce contact volume, improve resolution speed, and help customers get accurate answers faster.',
    bullets: [
      'AI agent strategy and workflow design',
      'Knowledge bases optimized for AI agents and human self-service',
      'Intent mapping, guardrails, and escalation logic',
      'Deflection, containment, CSAT, and resolution-rate tracking'
    ],
    icon: 'bot'
  },
  {
    title: 'Support Team Scaling & Workforce Design',
    description: 'Build and scale support teams that can handle growth without sacrificing quality, consistency, or customer trust.',
    bullets: [
      'Hiring, onboarding, and training frameworks',
      'Workforce planning and coverage models',
      'QA programs and agent enablement',
      'Seasonal spike and launch readiness'
    ],
    icon: 'users'
  },
  {
    title: 'Zendesk & CX Systems Optimization',
    description: 'Optimize Zendesk and connected support tools to improve speed, consistency, reporting, and customer visibility.',
    bullets: [
      'Zendesk workflows, triggers, automations, and macros',
      'Explore dashboards and KPI reporting',
      'Help center and knowledge management structure',
      'CRM, chat, messaging, and third-party integrations'
    ],
    icon: 'workflow'
  },
  {
    title: 'Voice of Customer & Customer Insight',
    description: 'Turn support data into actionable customer intelligence for product, retention, marketing, operations, and leadership teams.',
    bullets: [
      'Customer sentiment and issue trend analysis',
      'CSAT/NPS feedback loops',
      'Retention and cancellation signal analysis',
      'Executive-ready customer insight reporting'
    ],
    icon: 'chart'
  },
  {
    title: 'Vendor / BPO Performance Management',
    description: 'Create accountable outsourced support partnerships that scale efficiently while protecting customer experience quality.',
    bullets: [
      'Vendor selection and onboarding',
      'Performance management and QA standards',
      'SLA, CSAT, productivity, and escalation reporting',
      'Process alignment across internal and external teams'
    ],
    icon: 'handshake'
  }
];
---

<section id="services" class="py-20 relative scroll-mt-28">
  <div class="max-w-7xl mx-auto px-8 lg:px-12">
    <div class="text-center mb-16">
      <h2 class="text-4xl lg:text-5xl xl:text-6xl font-bold text-[var(--color-text)] mb-10 tracking-tight">
        How I Can Help
      </h2>
      <p class="text-lg lg:text-xl text-[var(--color-text-muted)] max-w-4xl mx-auto font-normal leading-relaxed mb-10">
        Executive-level customer operations support across strategy, systems, AI-enabled support, team scaling, and performance management.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
      {services.map((service) => {
        return (
        <article class="group rounded-[1.35rem] p-8 md:p-10 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 border hover:shadow-[0_20px_42px_rgba(2,6,12,0.55)] hover:border-[color:var(--color-primary-dark)]" style="background: color-mix(in srgb, var(--color-surface) 94%, transparent); border-color: var(--color-border); box-shadow: 0 14px 32px var(--color-shadow);">
          <div class="w-14 h-14 md:w-16 md:h-16 rounded-[1rem] flex items-center justify-center border mb-6" style="background: color-mix(in srgb, var(--color-surface-strong) 90%, transparent); border-color: var(--color-border); box-shadow: 0 10px 20px rgba(2, 6, 12, 0.4);">
              {service.icon === 'briefcase' && <svg class="w-7 h-7 text-[var(--color-icon)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18"></path></svg>}
              {service.icon === 'bot' && <svg class="w-7 h-7 text-[var(--color-icon)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="7" width="16" height="12" rx="3"></rect><path stroke-linecap="round" d="M12 4v3"></path><circle cx="9" cy="13" r="1"></circle><circle cx="15" cy="13" r="1"></circle></svg>}
              {service.icon === 'users' && <svg class="w-7 h-7 text-[var(--color-icon)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"></circle><path stroke-linecap="round" stroke-linejoin="round" d="M3 20a6 6 0 0 1 12 0"></path><circle cx="17" cy="9" r="2.5"></circle><path stroke-linecap="round" stroke-linejoin="round" d="M15 20a5 5 0 0 1 6 0"></path></svg>}
              {service.icon === 'workflow' && <svg class="w-7 h-7 text-[var(--color-icon)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect><path stroke-linecap="round" stroke-linejoin="round" d="M10 6h4a2 2 0 0 1 2 2v6"></path><path stroke-linecap="round" stroke-linejoin="round" d="M14 14l2 2 2-2"></path></svg>}
              {service.icon === 'chart' && <svg class="w-7 h-7 text-[var(--color-icon)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 20V10"></path><path stroke-linecap="round" stroke-linejoin="round" d="M10 20V4"></path><path stroke-linecap="round" stroke-linejoin="round" d="M16 20v-6"></path><path stroke-linecap="round" stroke-linejoin="round" d="M22 20H2"></path></svg>}
              {service.icon === 'handshake' && <svg class="w-7 h-7 text-[var(--color-icon)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 11l2 2a2 2 0 0 0 3 0l3-3"></path><path stroke-linecap="round" stroke-linejoin="round" d="M8 13l-2 2a2 2 0 1 1-3-3l4-4a3 3 0 0 1 4 0l1 1"></path><path stroke-linecap="round" stroke-linejoin="round" d="M16 11l2 2a2 2 0 1 0 3-3l-4-4a3 3 0 0 0-4 0l-1 1"></path></svg>}
            </div>
            <h3 class="text-2xl font-bold tracking-[-0.01em] text-[var(--color-text)] mb-4">{service.title}</h3>
            <p class="text-base md:text-lg text-[var(--color-text-muted)] leading-[1.75] mb-6">{service.description}</p>
            <ul class="space-y-3">
              {service.bullets.map((bullet) => (
                <li class="flex gap-3 items-start">
                  <svg class="w-4 h-4 mt-1 shrink-0 text-[var(--color-icon)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"></path>
                    <circle cx="12" cy="12" r="9"></circle>
                  </svg>
                  <span class="text-sm md:text-base text-[var(--color-text-muted)]">{bullet}</span>
                </li>
              ))}
            </ul>
          </article>
        );
      })}
    </div>
  </div>
</section>
