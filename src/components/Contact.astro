---
const channels: { href: string; label: string; value: string; external?: boolean }[] = [
  { href: 'mailto:yahor@darashkevich.com', label: 'Email', value: 'yahor@darashkevich.com' },
  { href: 'https://www.linkedin.com/in/darashkevich', label: 'LinkedIn', value: 'LinkedIn', external: true },
  { href: 'tel:+1-617-528-9656', label: 'Phone', value: '+1 (617) 528-9656' },
];
---

<section id="contact" class="py-16 sm:py-20 relative scroll-mt-28">
  <div class="max-w-3xl mx-auto px-6 sm:px-8 text-center">
    <h2 class="text-4xl lg:text-5xl font-bold text-[var(--color-text)] tracking-tight">
      Discuss an Opportunity
    </h2>
    <p class="mt-5 text-lg text-[var(--color-text-muted)] leading-relaxed">
      Open to VP and Head of Customer Experience roles, and a small number of consulting engagements for teams that need support operations built to scale.
    </p>

    <a
      href="https://calendly.com/darashkevich/30min"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary mt-8 inline-flex items-center justify-center rounded-[1.15rem] px-7 py-3.5 text-base font-semibold transition-all duration-300 hover:-translate-y-0.5"
    >
      Book a 30-minute call
    </a>

    <ul class="contact-channels">
      {channels.map((channel) => (
        <li>
          <a
            href={channel.href}
            class="contact-channel"
            {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <span class="contact-channel__label">{channel.label}</span>
            <span class="contact-channel__value">{channel.value}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-8 text-sm text-[var(--color-text-soft)] leading-relaxed">
      Remote · U.S. &amp; EU work-authorized
      <span aria-hidden="true"> · </span>
      <a
        href="https://www.upwork.com/freelancers/~011b1479d238052c29?companyReference=613482611598331906&mp_source=share"
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-2 hover:text-[var(--color-primary)]"
      >
        Upwork
      </a>
    </p>
  </div>
</section>

<style>
  .contact-channels {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-channel {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .contact-channel:hover .contact-channel__value,
  .contact-channel:focus-visible .contact-channel__value {
    color: var(--color-primary);
  }

  .contact-channel__label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-soft);
  }

  .contact-channel__value {
    font-size: 1rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 640px) {
    .contact-channels {
      flex-direction: row;
      justify-content: center;
      gap: 2rem;
    }
  }
</style>
