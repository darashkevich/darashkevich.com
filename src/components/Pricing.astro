---
// Pricing section component with liquid glass design
---

<section id="pricing" class="py-40 relative">
  <div class="max-w-7xl mx-auto px-8 lg:px-12">
    <!-- Header -->
    <div class="text-center mb-24">
      <h2 class="text-5xl lg:text-6xl xl:text-7xl font-bold text-slate-900 mb-10 tracking-tight">
        Pricing
      </h2>
      <p class="text-xl lg:text-2xl xl:text-3xl text-slate-600 max-w-5xl mx-auto font-light leading-relaxed mb-10">
        Transparent pricing for all my services. All packages can be customized to fit your specific needs.
      </p>
      <div class="w-40 h-1.5 bg-gradient-to-r from-blue-500/60 via-indigo-500/60 to-blue-600/60 mx-auto rounded-full"></div>
    </div>

    <!-- Pricing Table -->
    <div class="bg-white/40 backdrop-blur-xl rounded-3xl p-12 border border-white/30 shadow-xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-white/30">
              <th class="text-left py-6 px-8 text-2xl font-bold text-slate-900">Service</th>
              <th class="text-left py-6 px-8 text-2xl font-bold text-slate-900">Description</th>
              <th class="text-right py-6 px-8 text-2xl font-bold text-slate-900">Starting Price</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-white/20 hover:bg-white/30 transition-colors duration-300">
              <td class="py-8 px-8 text-xl font-semibold text-slate-800">Zendesk Workflows</td>
              <td class="py-8 px-8 text-lg text-slate-600 font-light">
                Custom setup, macros, triggers, and automation to streamline your support operations
              </td>
              <td class="py-8 px-8 text-right text-2xl font-bold text-[var(--color-primary)]">$2,500</td>
            </tr>
            <tr class="border-b border-white/20 hover:bg-white/30 transition-colors duration-300">
              <td class="py-8 px-8 text-xl font-semibold text-slate-800">Support Agent Training</td>
              <td class="py-8 px-8 text-lg text-slate-600 font-light">
                Comprehensive onboarding programs and ongoing coaching to maximize team performance
              </td>
              <td class="py-8 px-8 text-right text-2xl font-bold text-[var(--color-primary)]">$1,800</td>
            </tr>
            <tr class="border-b border-white/20 hover:bg-white/30 transition-colors duration-300">
              <td class="py-8 px-8 text-xl font-semibold text-slate-800">AI &amp; Self-Service</td>
              <td class="py-8 px-8 text-lg text-slate-600 font-light">
                Create a comprehensive self-serve library that reduces ticket volume and empowers customers
              </td>
              <td class="py-8 px-8 text-right text-2xl font-bold text-[var(--color-primary)]">$3,500</td>
            </tr>
            <tr class="hover:bg-white/30 transition-colors duration-300">
              <td class="py-8 px-8 text-xl font-semibold text-slate-800">CX Strategy & Process</td>
              <td class="py-8 px-8 text-lg text-slate-600 font-light">
                Define KPIs, build scalable support frameworks, and create processes that grow with your business
              </td>
              <td class="py-8 px-8 text-right text-2xl font-bold text-[var(--color-primary)]">$4,000</td>
            </tr>
          </tbody>
        </table>
      </div>
      
      <!-- Note -->
      <div class="mt-12 pt-8 border-t border-white/30">
        <p class="text-center text-lg text-slate-600 font-light">
          All prices are starting points. Final pricing depends on project scope, complexity, and timeline. 
          <a href="#contact" class="text-[var(--color-primary)] hover:text-[var(--color-icon)] font-semibold underline">Contact me</a> for a custom quote.
        </p>
      </div>
    </div>
  </div>
</section>
