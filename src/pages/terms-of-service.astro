---
import Layout from '../layouts/Layout.astro';
import LegalHeader from '../components/LegalHeader.astro';
---

<Layout
  title="Terms of Service | Yahor Darashkevich"
  description="Terms of Service for Yahor Darashkevich portfolio website."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Terms of Service', path: '/terms-of-service/' },
  ]}
>
  <LegalHeader />
  <article class="py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="backdrop-blur-xl rounded-3xl border p-8 md:p-12" style="background-color: var(--color-surface); border-color: var(--color-border); box-shadow: 0 16px 38px var(--color-shadow);">
        <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-4 tracking-tight">Terms of Service</h1>
        <p class="text-[var(--color-text-soft)] mb-10">Effective date: May 6, 2026</p>

        <div class="space-y-8 text-[var(--color-text-muted)] leading-relaxed">
          <section>
            <h2 class="text-2xl font-semibold text-[var(--color-text)] mb-3">1. Acceptance of Terms</h2>
            <p>
              By accessing or using this website, you agree to be bound by these Terms of Service and all applicable
              laws and regulations.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold text-[var(--color-text)] mb-3">2. Services and Website Use</h2>
            <p>
              This website is provided for informational purposes and to facilitate inquiries about consulting and
              customer support services. Service engagements are subject to separate written agreements.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold text-[var(--color-text)] mb-3">3. Intellectual Property</h2>
            <p>
              All content on this website, including text, graphics, branding, and layout, is owned by or licensed
              to Yahor Darashkevich unless otherwise stated. Unauthorized use is prohibited.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold text-[var(--color-text)] mb-3">4. User Conduct</h2>
            <p>You agree not to:</p>
            <ul class="list-disc pl-6 mt-2 space-y-1">
              <li>Use the site for unlawful, harmful, or fraudulent purposes.</li>
              <li>Attempt to interfere with the website’s operation or security.</li>
              <li>Copy, scrape, or redistribute content without authorization.</li>
            </ul>
          </section>

          <section>
            <h2 class="text-2xl font-semibold text-[var(--color-text)] mb-3">5. Third-Party Services</h2>
            <p>
              This site may link to third-party services (for example, scheduling and social platforms). Those
              services are governed by their own terms and policies.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold text-[var(--color-text)] mb-3">6. Disclaimer</h2>
            <p>
              The website is provided on an "as is" and "as available" basis without warranties of any kind, express
              or implied, to the fullest extent permitted by law.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold text-[var(--color-text)] mb-3">7. Limitation of Liability</h2>
            <p>
              To the fullest extent permitted by law, Yahor Darashkevich will not be liable for any indirect,
              incidental, consequential, special, or punitive damages arising from use of this website.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold text-[var(--color-text)] mb-3">8. Indemnification</h2>
            <p>
              You agree to indemnify and hold harmless Yahor Darashkevich from claims, damages, and expenses arising
              out of your misuse of the website or violation of these terms.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold text-[var(--color-text)] mb-3">9. Termination</h2>
            <p>
              Access to the website may be suspended or terminated at any time, without notice, if misuse or violation
              of these terms is suspected.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold text-[var(--color-text)] mb-3">10. Governing Law</h2>
            <p>
              These terms are governed by applicable laws in the relevant jurisdiction, without regard to conflict of
              law principles.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold text-[var(--color-text)] mb-3">11. Changes to Terms</h2>
            <p>
              These Terms of Service may be updated at any time. Continued use of the website after changes are posted
              constitutes acceptance of the revised terms.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold text-[var(--color-text)] mb-3">12. Contact</h2>
            <p>
              For questions about these terms, contact:
              <a class="text-[var(--color-primary)] underline underline-offset-2 hover:text-[var(--color-icon)] ml-1" href="mailto:yahor@darashkevich.com">
                yahor@darashkevich.com
              </a>
            </p>
          </section>
        </div>
      </div>
    </div>
  </article>
</Layout>
