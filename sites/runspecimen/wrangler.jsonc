{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "runspecimen",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "runspecimen.darashkevich.com",
      "custom_domain": true
    }
  ]
}
